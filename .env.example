# Copy to .env.local for local development. Never commit real values.

# The password visitors type on /login.
SITE_PASSWORD=

# Long random string that signs the session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Behavior when these are missing:
# - development: the gate stays open so `npm run dev` works out of the box.
# - production: the site fails closed and returns 503 until both are set.

# Storage for the live action plan (the "Who does what, by when" board).
# Preferred: Vercel Postgres / Neon. The table is created automatically.
POSTGRES_URL=

# Optional fallback: Vercel KV (Upstash). Used only if POSTGRES_URL is unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# With none of these set, the plan falls back to in-process memory:
# fine locally, but edits do not survive a redeploy or scale out.
